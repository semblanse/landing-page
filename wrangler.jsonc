{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Cloudflare Pages reads its bindings from this file on each deploy.
  // Secrets (TURNSTILE_SECRET_KEY, RESEND_API_KEY) are set on the Pages
  // project, and in .dev.vars for local runs. See README.md.
  "name": "semblanse-landing-preview",
  "pages_build_output_dir": "out",
  "compatibility_date": "2026-10-01",
  "vars": {
    "EMAIL_FROM": "Semblanse <hello@semblanse.com>",
    "EMAIL_NOTIFY": "hello@semblanse.com",
    "POSTHOG_API_KEY": "phc_o2M3cGEHRQzchsgDxU8nRa4f3LKRk4q6uzbYB2RMStDe",
    "ANALYTICS_EVENT_LIMIT": "25000",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "semblanse-enquiries-preview",
      // Replace with the id printed by `wrangler d1 create`.
      "database_id": "02ba791a-c964-409e-87c4-226e8f9bbb75",
      "migrations_dir": "migrations",
    },
  ],
}
