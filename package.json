{
  "name": "semblanse-landing-page",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "email:retry": "tsx scripts/retry-email.mjs",
    "dev": "next dev",
    "build": "next build && node scripts/security-headers.mjs",
    "build:production": "node scripts/build-production.mjs",
    "deploy:production": "npm run build:production && node scripts/deploy-production.mjs",
    "start": "wrangler pages dev out",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit && npm run types && tsc --noEmit -p functions",
    "deploy:preview": "npm run build && wrangler pages deploy out --project-name=semblanse-landing-preview --branch=revision-3",
    "format": "prettier --write src",
    "types": "wrangler types functions/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "preview": "npm run build && npm run db:migrate:local && wrangler pages dev"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/albert-sans": "^5.3.0",
    "@fontsource/gfs-didot": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.21.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.149.0"
  }
}
